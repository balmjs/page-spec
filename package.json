{
  "name": "page-spec",
  "version": "1.0.0",
  "description": "Cross-browser extension to extract authenticated web PRD bundles & API specs into clean Markdown, with WebMCP integration.",
  "private": true,
  "type": "module",
  "bin": {
    "pagespec-bridge": "./bin/mcp-bridge.mjs"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "bridge": "node ./bin/mcp-bridge.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@truto/turndown-plugin-gfm": "^1.0.5",
    "fflate": "^0.8.3",
    "lucide-vue-next": "^1.0.0",
    "turndown": "^7.2.4",
    "vue": "^3.5.29",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^22.14.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vue-tsc": "^2.2.8",
    "wxt": "^0.21.4"
  }
}
